        "pythonCode": "items=_input.all()\nprint(type(items))\nprint(type(items[0]))\nquery_to_search=items[0]['json']\n['query']\nprint(type(query_to_search))\nprint(query_to_search)\noutput=[]\n\nfor item in items[0]['json']['dataset']:\n  \n\n  \n  if query_to_search==item['Query']:\n    print(item['Query'])\n    output.append({\"Response\":item['Response']})\n    break\nif not output:\n  output.append({\"Response\":\"\"})\n      \nreturn output\n\n  "
