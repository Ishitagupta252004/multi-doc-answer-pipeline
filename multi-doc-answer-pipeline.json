    {
      "parameters": {
        "jsCode": "const pdfText = $input.first().json.text;\nconst queryInfo = $('Loop Over queries').first().json;\n\nconst prompt = `You are an AI assistant. Use the knowledge base which has the vector embeddings in the simple vector store of the document to answer the user's question.\n\nQuestion: ${queryInfo.query}\n\nDocument: ${pdfText}\n\nOnly use information from the document to answer. Be clear, concise, and factual.`;\n\nreturn [{\n  json: {\n    prompt: prompt,\n    query: queryInfo.query,\n    index: queryInfo.index\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        498.75
      ],
      "id": "a58b9f06-62e4-4b33-b7da-3955c235978f",
      "name": "Create LLM Prompt"
    },
    {
      "parameters": {
        "jsCode": "const modelA = $('Basic LLM Chain').first().json.text;\nconst modelB = $('Message a model').first().json.message.content[0].text;\nconst query = $('Loop Over queries').first().json.query;\nconst document = $('Extract PDF Text').first().json.text;\n\nconst judgePrompt = `Compare these two answers to: \"${query}\"\nAnswer A: ${modelA}\nAnswer B: ${modelB}\nWhich answer is more accurate and complete based on the document? Respond with \"A\", \"B\", or \"Tie\" and explain why in one sentence.`;\n\nreturn [{\n  json: {\n    judgePrompt: judgePrompt,\n    query: query,\n    modelA: modelA,\n    modelB: modelB,\n    document: document\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        498.75
      ],
      "id": "bfc1e4db-4869-4186-9970-4cbfcf3b0057",
      "name": "Prepare Judge Prompt"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "o3-mini",
          "mode": "list",
          "cachedResultName": "O3-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.judgePrompt }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        2260,
        498.75
      ],
      "id": "84f07894-6f47-4fc7-bfe7-d7b9589d4e18",
      "name": "Judge LLM",
      "credentials": {
        "openAiApi": {
          "id": "oivCLuUpKjU6qeV3",
          "name": "OpenAi account 6"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const judgeResponse = $input.first().json.message.content;\nconst queryInfo = $('Loop Over queries').first().json;\n\n// Determine which model won based on the judge's response\nlet bestAnswer = \"\";\nlet winningModel = \"\";\n\nif (judgeResponse.includes(\"A –\") || judgeResponse.toLowerCase().includes(\"answer a\")) {\n  bestAnswer = $('Basic LLM Chain').first().json.text;\n  winningModel = \"Model A (Gemini)\";\n} else if (judgeResponse.includes(\"B –\") || judgeResponse.toLowerCase().includes(\"answer b\")) {\n  bestAnswer = $('Message a model').first().json.message.content[0].text;\n  winningModel = \"Model B (OpenAI)\";\n} else {\n  // Fallback - use the judge's response itself\n  bestAnswer = judgeResponse;\n  winningModel = \"Judge Decision\";\n}\n\nreturn [{\n  json: {\n    query: queryInfo.query,\n    found: true,\n    answer: bestAnswer,\n    winningModel: winningModel,\n    judgeReasoning: judgeResponse,\n    source: \"llm_processed\",\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2620,
        498.75
      ],
      "id": "d4fcc16c-d74b-490d-9b21-47451af3c693",
      "name": "Extract Final Answer"
    },
    {
      "parameters": {
        "jsCode": "// Get the merged result from previous node\nconst currentResult = $input.first().json;\n\n// Get the query info from Loop Over Items node\nconst queryInfo = $('Loop Over queries').first().json;\n\n// Get existing results array or initialize\nlet allResults = queryInfo.allResults || [];\n\n// Add current result to the array\nconst newResult = {\n  query: currentResult.query,\n  found: currentResult.found,\n  answer: currentResult.answer || currentResult.response,\n  source: currentResult.source || (currentResult.response ? \"database\" : \"llm_processed\"),\n  winningModel: currentResult.winningModel || null,\n  judgeReasoning: currentResult.judgeReasoning || null,\n  processed_at: currentResult.processed_at || new Date().toISOString()\n};\n\nallResults.push(newResult);\n\n// Return the updated results array to continue the loop\nreturn [{\n  json: {\n    query: currentResult.query,\n    found: currentResult.found,\n    answer: currentResult.answer || currentResult.response,\n    source: currentResult.source || (currentResult.response ? \"database\" : \"llm_processed\"),\n    winningModel: currentResult.winningModel || null,\n    judgeReasoning: currentResult.judgeReasoning || null,\n    processed_at: currentResult.processed_at || new Date().toISOString(),\n    allResults: allResults // Pass the updated array back to loop\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3060,
        548.75
      ],
      "id": "8020be27-e163-4425-b885-d2fbe2c4139d",
      "name": "Prepare for Next"
    },
    {
      "parameters": {
        "jsCode": "// This runs after all loop iterations are complete\n// Collect all answers from the input array\nconst allInputs = $input.all();\nconst answers = [];\n\n// Extract answers from each input item\nallInputs.forEach(item => {\n  if (item.json.answer) {\n    answers.push(item.json.answer);\n  }\n});\n\n// Create final response structure with just answers\nconst finalResponse = {\n  success: true,\n  answers: answers\n};\n\nreturn [{ json: finalResponse }];"
      },
